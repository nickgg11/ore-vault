+package com.orevault.orevault.vault;
+
+import com.orevault.orevault.data.DataPaths;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.Iterator;
+import java.util.Map;
+import java.util.UUID;
+import java.util.stream.Stream;
+import net.minecraft.resources.ResourceKey;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.level.Level;
+import net.neoforged.neoforge.common.NeoForge;
+import net.neoforged.neoforge.event.level.LevelEvent;
+import net.neoforged.neoforge.event.tick.ServerTickEvent;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/**
+ * SPIKE (E3-S11, #245), throwaway: ADR 0002's removal steps 1 to 5 and 7 for one Vault, with the drain of step 3 advanced
+ * once a tick from {@code ServerTickEvent.Post}, outside any level's tick. Not for merging.
+ */
+public final class VaultUnloadSpike {
+    private static final Logger LOGGER = LoggerFactory.getLogger(VaultUnloadSpike.class);
+    private static final int BOUND_TICKS = 200;
+    private static final Map<UUID, Pending> PENDING = new HashMap<>();
+
+    private record Pending(ServerLevel level, int startTick) {
+    }
+
+    private VaultUnloadSpike() {
+    }
+
+    public static void register() {
+        NeoForge.EVENT_BUS.addListener(VaultUnloadSpike::onServerTick);
+    }
+
+    /** Steps 1 and 2. */
+    public static String start(MinecraftServer server, UUID teamId) {
+        ResourceKey<Level> key = VaultDimensions.dimensionKey(teamId);
+        ServerLevel level = server.getLevel(key);
+        if (level == null) {
+            return "unload team=" + teamId + " refused: no level";
+        }
+        if (!level.players().isEmpty()) {
+            return "unload team=" + teamId + " refused: " + level.players().size() + " players inside";
+        }
+        level.getChunkSource().deactivateTicketsOnClosing();
+        PENDING.put(teamId, new Pending(level, server.getTickCount()));
+        LOGGER.info("Unloading Vault {} of team {} (spike): tickets deactivated at server tick {}", key.identifier(), teamId,
+                server.getTickCount());
+        return "unload team=" + teamId + " unloading";
+    }
+
+    /** Step 3, then 4, 5 and 7. */
+    private static void onServerTick(ServerTickEvent.Post event) {
+        MinecraftServer server = event.getServer();
+        for (Iterator<Map.Entry<UUID, Pending>> it = PENDING.entrySet().iterator(); it.hasNext(); ) {
+            Map.Entry<UUID, Pending> entry = it.next();
+            ServerLevel level = entry.getValue().level();
+            int ticks = server.getTickCount() - entry.getValue().startTick();
+            level.getChunkSource().deactivateTicketsOnClosing();
+            if (level.getChunkSource().chunkMap.hasWork()) {
+                if (ticks >= BOUND_TICKS) {
+                    LOGGER.error("Unloading Vault {} (spike) failed: the chunk map still has work after {} ticks",
+                            level.dimension().identifier(), ticks);
+                    it.remove();
+                }
+                continue;
+            }
+            it.remove();
+            try {
+                level.save(null, true, false);
+                NeoForge.EVENT_BUS.post(new LevelEvent.Unload(level));
+                level.close();
+            } catch (IOException | RuntimeException e) {
+                LOGGER.error("Closing Vault {} (spike) failed", level.dimension().identifier(), e);
+                continue;
+            }
+            VaultLevels.remove(server, level.dimension());
+            LOGGER.info("Unloaded Vault {} of team {} (spike): drain {} ticks, removed at server tick {}",
+                    level.dimension().identifier(), entry.getKey(), ticks, server.getTickCount());
+        }
+    }
+
+    /** Check 2: move the folder aside and delete it, as ADR 0007 step 8 would. */
+    public static String delete(MinecraftServer server, UUID teamId) {
+        Path folder = DataPaths.vaultFolder(server, teamId);
+        if (server.getLevel(VaultDimensions.dimensionKey(teamId)) != null) {
+            return "delete team=" + teamId + " refused: still registered";
+        }
+        Path moved = folder.resolveSibling(folder.getFileName() + ".deleting");
+        try {
+            Files.move(folder, moved);
+            try (Stream<Path> walk = Files.walk(moved)) {
+                for (Path path : walk.sorted(Comparator.reverseOrder()).toList()) {
+                    Files.delete(path);
+                }
+            }
+        } catch (IOException e) {
+            LOGGER.error("Deleting {} (spike) failed", folder, e);
+            return "delete team=" + teamId + " failed: " + e;
+        }
+        LOGGER.info("Deleted Vault folder {} (spike) after moving it to {}", folder, moved);
+        return "delete team=" + teamId + " deleted";
+    }
+
+    public static String folder(MinecraftServer server, UUID teamId) {
+        Path folder = DataPaths.vaultFolder(server, teamId);
+        return "folder team=" + teamId + " exists=" + Files.exists(folder) + " deleting="
+                + Files.exists(folder.resolveSibling(folder.getFileName() + ".deleting"))
+                + " far_region=" + Files.exists(folder.resolve("region").resolve("r.1.1.mca"));
+    }
+}
